# ─── URL pública del sitio (sin barra final) ───
# En Vercel se completa solo en producción; defínela para back_urls y enlaces de email.
SITE_URL=https://franciscanutricion.vercel.app

# ─── Supabase ───
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Clave service_role (SOLO servidor, nunca exponer en el frontend)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGci...
# Bucket privado donde se guardan los PDFs de los iBooks
SUPABASE_PDF_BUCKET=ibooks

# ─── Mercado Pago ───
# Access Token de producción (Checkout Pro)
MP_ACCESS_TOKEN=APP_USR-xxxxxxxx
# Secreto de la integración para validar la firma del webhook (opcional pero recomendado)
MP_WEBHOOK_SECRET=

# ─── Resend (emails) ───
RESEND_API_KEY=re_xxxxxxxx
# Remitente verificado en Resend
RESEND_FROM=Francisca Nutrición <hola@franciscanutricion.com>

# ─── Panel administrativo ───
# Token simple para proteger /admin.html
ADMIN_TOKEN=cambia-esto-por-un-token-seguro
